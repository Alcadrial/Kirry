#version 460

layout (binding = 0) uniform U {
	vec2 matrix0;
	vec2 matrix1;
	uint offset;
	uint stride;
	uint size;
};

layout (std430, binding = 1) buffer Data {
   float data[]; // vec2[]
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint k = (offset + gl_GlobalInvocationID.x * size + stride) / 4;

	vec2 v = vec2(data[k], data[k + 1]);
	vec2 w = matrix0 * v.x + matrix1 * v.y;
	
    data[k] = w.x;
    data[k + 1] = w.y;
}