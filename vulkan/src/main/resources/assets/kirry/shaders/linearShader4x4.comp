#version 460

layout (binding = 0) uniform U {
	mat4 matrix;
	uint offset;
	uint stride;
	uint size;
};

layout (std430, binding = 1) buffer Data {
   float data[]; // vec4[]
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint k = (offset + gl_GlobalInvocationID.x * size + stride) / 4;

	vec4 v = vec4(data[k], data[k + 1], data[k + 2], data[k + 3]);
	vec4 w = matrix * v;
	
    data[k] = w.x;
    data[k + 1] = w.y;
    data[k + 2] = w.z;
    data[k + 3] = w.w;
}