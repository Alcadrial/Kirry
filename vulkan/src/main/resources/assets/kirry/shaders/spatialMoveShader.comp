#version 460

struct Data {
	float e[6];
};

layout (binding = 0) uniform U {
	vec3 position;
	vec3 newPosition;
};

layout (std430, binding = 1) buffer S {
	Data data[];
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint i = gl_GlobalInvocationID.x;

    data[i].e[0] += newPosition.x - position.x;
    data[i].e[1] += newPosition.y - position.y;
    data[i].e[2] += newPosition.z - position.z;
}