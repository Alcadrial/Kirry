#version 460

struct Data {
	float e[6];
};

layout (binding = 0) uniform U {
	vec3 position;
	vec3 newPosition;
	uint offset;
};

layout (std430, binding = 1) buffer S {
	float data[]; // data[6][]
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint i = offset / 4 + gl_GlobalInvocationID.x * 6;

    data[i + 0] += newPosition.x - position.x;
    data[i + 1] += newPosition.y - position.y;
    data[i + 2] += newPosition.z - position.z;
}