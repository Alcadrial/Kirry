#version 460

layout (binding = 0) uniform U {
	vec2 newRegionUvStart;
	vec2 newRegionUvEnd;
	vec2 oldRegionUvStart;
};

layout (std430, binding = 1) buffer Data {
   vec2 textureUv[];
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint i = gl_GlobalInvocationID.x;  

    textureUv[i] += (newRegionUvStart - oldRegionUvStart) / (newRegionUvEnd - newRegionUvStart); 
}