#version 450

struct Particle {
  vec3 position;
  vec3 velocity;
};

layout (binding = 0) uniform U {
	vec3 MIN_BOUND;
	vec3 MAX_BOUND;
	float ENLAPSED_TIME;
};

layout (std430, binding = 1) readonly buffer Input {
   Particle particlesIn[];
};

layout (std430, binding = 2) buffer Output {
   Particle particlesOut[];
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main()
{
	uint i = gl_GlobalInvocationID.x;  

    Particle particle = particlesIn[i];

	vec3 movement = particle.velocity * ENLAPSED_TIME;
    vec3 newPosition = particle.position + movement;
    vec3 newVelocity = particle.velocity;
    
    bool bounce = false;
    float remainingTime = ENLAPSED_TIME;
    
    while (bounce)
    {
    	if (newPosition.x < MIN_BOUND.x)
    	{
    		bounce = true;
    		
    		float dx = particle.position.x - MIN_BOUND.x;
    		float t = dx / particle.velocity.x;
    		float dy = t * particle.velocity.y;
    		
    		remainingTime -= t;
    		particle.position.x -= dx;
    		particle.position.y += dy;
    		particle.velocity.x = -particle.velocity.x;
    		
			movement = particle.velocity * remainingTime;
    		newPosition = particle.position + movement;
    		newVelocity = particle.velocity;
    	}
    }
    
    particlesOut[i].position = newPosition;
    particlesOut[i].velocity = newVelocity;
}