#version 450

struct Particle {
  vec3 position;
  vec3 velocity;
  vec4 color;
};

layout (binding = 0) uniform U {
	float ENLAPSED_TIME;
	vec3 MIN_BOUND;
	vec3 MAX_BOUND;
};

layout (std140, binding = 1) readonly buffer Input {
   Particle particlesIn[];
};

layout (std140, binding = 2) buffer Output {
   Particle particlesOut[];
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void bounceBarrier(inout float time, vec3 barrierPosition, vec3 barrierNormal, inout vec3 particlePosition, inout vec3 particleVelocity)
{
	float barrierDistance = abs(dot(barrierNormal, particlePosition) + dot(barrierNormal, barrierPosition));
	vec3 p = dot(barrierNormal, particleVelocity);
	float t = barrierDistance / p;
	time -= t;
	particlePosition += particleVelocity * t;
	particleVelocity -= 2 * barrierNormal * p;
}

void main()
{
	uint i = gl_GlobalInvocationID.x;

    Particle particle = particlesIn[i];

	vec3 movement = particle.velocity * ENLAPSED_TIME;
    vec3 lastPosition = particle.position;
    vec3 lastVelocity = particle.velocity;
    vec3 newPosition;
    vec3 newVelocity;
    
    bool bounce = true;
    float remainingTime = ENLAPSED_TIME;
    while (bounce)
    {
    	newPosition = lastPosition + lastVelocity * remainingTime;
    	newVelocity = lastVelocity;
    	bounce = false;
    	if (newPosition.x < MIN_BOUND.x)
    	{
    		bounce = true;
    		vec3 v = vec3(MIN_BOUND.x, 0, 0);
    		bounceBarrier(remainingTime, v, normalize(-v), lastPosition, lastVelocity);
    	}
    	if (newPosition.y < MIN_BOUND.y)
    	{
    		bounce = true;
    		vec3 v = vec3(0, MIN_BOUND.y, 0);
    		bounceBarrier(remainingTime, v, normalize(-v), lastPosition, lastVelocity);
    	}
    	if (newPosition.z < MIN_BOUND.z)
    	{
    		bounce = true;
    		vec3 v = vec3(0, 0, MIN_BOUND.z);
    		bounceBarrier(remainingTime, v, normalize(-v), lastPosition, lastVelocity);
    	}
    	if (newPosition.x > MAX_BOUND.x)
    	{
    		bounce = true;
    		vec3 v = vec3(MIN_BOUND.x, 0, 0);
    		bounceBarrier(remainingTime, v, normalize(-v), lastPosition, lastVelocity);
    	}
    	if (newPosition.y > MAX_BOUND.y)
    	{
    		bounce = true;
    		vec3 v = vec3(0, MAX_BOUND.y, 0);
    		bounceBarrier(remainingTime, v, normalize(-v), lastPosition, lastVelocity);
    	}
    	if (newPosition.z > MAX_BOUND.z)
    	{
    		bounce = true;
    		vec3 v = vec3(0, 0, MAX_BOUND.z);
    		bounceBarrier(remainingTime, v, normalize(-v), lastPosition, lastVelocity);
    	}
    }
    particlesOut[i].position = newPosition;
    particlesOut[i].velocity = newVelocity;
    particlesOut[i].color = particle.color;
}