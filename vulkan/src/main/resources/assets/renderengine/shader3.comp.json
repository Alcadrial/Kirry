			"variables": [
				"vec3 position",
				"vec3 velocity",
				"vec4 color"
			]
		},
		{
			"type": "storageBuffer",
			"binding": 2,
			"usage": "output",
			"variables": [
				"vec3 position",
				"vec3 velocity",
				"vec4 color"
			]
		},
		{
			"type": "localSize",
			"xSize": "256",
			"ySize": "1",
			"zSize": "1"
		}
	]
}